{"kind": "evidence", "tid": "TE012", "fact_tid": "TF012", "type": "text_quote", "source_url": "https://hydrogencouncil.com/wp-content/uploads/2024/09/Hydrogen-Insights-2024.pdf", "archived_url": null, "local": "_research/market-players-policy/raw/85ffdd6a385c_clean.txt", "sha256": "52ef957b7329f8b084c7e60210567a926856ebef992f2f0f0836028baf84e93b", "accessed_at": "2026-07-21T13:37:19.572000+00:00", "http_status": 200, "locator": {"page": 14}, "verbatim": "375 GW of electrolysis capacity has been announced through 2030, up from 305 GW previously", "source_role": "원출처", "proposed_grade": {"authority": "B", "independence": "B", "directness": "A", "recency": "A"}, "capture": null}

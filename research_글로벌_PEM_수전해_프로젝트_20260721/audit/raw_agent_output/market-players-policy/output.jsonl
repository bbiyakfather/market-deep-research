{"kind": "evidence", "tid": "TE011", "fact_tid": "TF011", "type": "text_quote", "source_url": "https://www.iea.org/energy-system/low-emission-fuels/electrolysers", "archived_url": "https://web.archive.org/web/20260526183547/https://www.iea.org/energy-system/low-emission-fuels/electrolysers", "local": "_research/market-players-policy/raw/27a2308ade90_clean.txt", "sha256": "3e2b08496785cbea6d07c392c54c81b495a1e36ab4279964cc9af4b719cfbb7f", "accessed_at": "2026-07-21T13:32:35.204074+00:00", "http_status": 200, "locator": null, "verbatim": "If all the announced projects are realised, global electrolysis capacity could reach 230 GW by 2030 (520 GW by including also projects at early stages of development).", "source_role": "원출처", "proposed_grade": {"authority": "A", "independence": "A", "directness": "A", "recency": "B"}, "capture": null}

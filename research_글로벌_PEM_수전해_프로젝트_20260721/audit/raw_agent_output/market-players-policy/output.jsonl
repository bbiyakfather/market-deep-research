{"kind": "evidence", "tid": "TE013", "fact_tid": "TF013", "type": "text_quote", "source_url": "https://www.iea.org/energy-system/low-emission-fuels/electrolysers", "archived_url": "https://web.archive.org/web/20260526183547/https://www.iea.org/energy-system/low-emission-fuels/electrolysers", "local": "_research/market-players-policy/raw/27a2308ade90_clean.txt", "sha256": "3e2b08496785cbea6d07c392c54c81b495a1e36ab4279964cc9af4b719cfbb7f", "accessed_at": "2026-07-21T13:32:35.204074+00:00", "http_status": 200, "locator": null, "verbatim": "Electrolysis capacity is growing from a low base and requires a significant acceleration to get on track with the Net Zero Emissions by 2050 (NZE) Scenario, which requires installed electrolysis capacity to reach 560 GW by 2030.", "source_role": "원출처", "proposed_grade": {"authority": "A", "independence": "A", "directness": "A", "recency": "B"}, "capture": null}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "market-deep-research facts + evidence schema (v3)",
  "description": "facts_db.py 의 검증 기준. 외부 jsonschema 라이브러리 없이 required/enum/const 를 직접 읽어 경량 검증한다.",
  "enums": {
    "grade": ["A", "B", "C", "D"],
    "status": ["confirmed", "pending", "disputed", "superseded", "discarded"],
    "risk": ["high", "normal"],
    "evidence_type": ["text_quote", "table_cell", "chart", "api_response", "negative_search", "calculation"],
    "source_role": ["원출처", "재인용", "보도자료"],
    "basis": ["actual", "estimate", "forecast", "nominal", "real", "annual", "quarterly", "ttm"],
    "dispute_kind": ["refuted", "definition_conflict", "unresolved"],
    "derivation": ["source", "computed", "inferred"],
    "evidence_verdict": ["support", "contradict", "uncertain"]
  },
  "fact": {
    "required": ["claim_key", "id", "claim", "context", "value", "grade", "risk", "status"],
    "properties": {
      "claim_key": {"type": "string", "description": "안정적 diff 키. 'metric|entity|geo|period|basis|scenario' 조합. 순번(F001) 아님."},
      "id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
      "claim": {"type": "string"},
      "context": {
        "required": ["metric", "entity", "geography", "period"],
        "properties": {
          "metric": {"type": "string"},
          "entity": {"type": "string"},
          "entity_id": {"type": ["string", "null"], "description": "사업자/법인번호 등 동일성 식별자"},
          "geography": {"type": "string"},
          "period": {"type": "string"},
          "as_of": {"type": ["string", "null"], "description": "자료 기준시점(공시월 등)"},
          "basis": {"type": ["string", "null"], "enum_ref": "basis"},
          "scenario": {"type": ["string", "null"]},
          "definition": {"type": ["string", "null"], "description": "측정 정의(예: 연결기준 매출)"}
        }
      },
      "value": {
        "required": ["raw", "unit"],
        "properties": {
          "raw": {"type": "string"},
          "unit": {"type": "string"},
          "decimal": {"type": ["string", "null"], "description": "Decimal 문자열(검산·비교용)"}
        }
      },
      "grade": {
        "required": ["authority", "independence", "directness", "recency"],
        "properties": {
          "authority": {"enum_ref": "grade"},
          "independence": {"enum_ref": "grade"},
          "directness": {"enum_ref": "grade"},
          "recency": {"enum_ref": "grade"}
        }
      },
      "risk": {"enum_ref": "risk", "description": "high = claim-graph 게이트(반박검색·독립그룹) 적용 대상"},
      "status": {"enum_ref": "status"},
      "verified_by": {"type": ["string", "null"], "description": "'lead' 만 confirm 가능. verifier 단독 confirm 금지."},
      "verify_events": {"type": "array", "description": "누적 검증 이벤트 [{by, at, action, note}]"},
      "evidence_ids": {"type": "array"},

      "independent_groups": {"type": "array", "description": "[v3-B] 독립 관찰그룹 라벨 목록. 재전재는 같은 그룹."},
      "counter_search": {
        "type": ["object", "null"],
        "description": "[v3-B] 능동 반박검색 결과",
        "properties": {
          "query": {"type": "string"},
          "result": {"type": "string"},
          "found_stronger_refutation": {"type": "boolean"}
        }
      },
      "primary_source_ref": {"type": ["string", "null"], "description": "[v3-B] 기본소스 evidence id(공시·표준·원데이터)"},

      "observed_at": {"type": ["string", "null"], "description": "[v3-E] 우리가 관측한 시점"},
      "valid_at": {"type": ["string", "null"], "description": "[v3-E] 주장이 유효한 시점"},
      "last_seen": {"type": ["string", "null"], "description": "[v3-E] 마지막으로 소스에서 확인된 시점(상태변경 추적)"},

      "discard_reason": {"type": ["string", "null"]},

      "superseded_by": {"type": ["string", "null"], "description": "[v4-V] 이 fact 를 대체한 새 fact id. 모순된 fact 는 삭제 대신 disputed→supersede 체인으로 남긴다."},
      "dispute_kind": {"type": ["string", "null"], "enum_ref": "dispute_kind", "description": "[v4-V] disputed 세분: refuted(새 증거가 뒤집음 — supersede 체인 요구) | definition_conflict(정의차 상반 병기 — 정당한 종착) | unresolved(미해결)"},
      "derivation": {"type": ["string", "null"], "enum_ref": "derivation", "description": "[v4-N] source(출처 수치) | computed(계산 파생 — G5c 대상) | inferred(추론 — 보고서 10부 사실/추론 구분 전용)"}
    }
  },
  "evidence": {
    "required": ["id", "fact_id", "type", "source_url", "sha256", "accessed_at"],
    "properties": {
      "id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
      "fact_id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
      "type": {"enum_ref": "evidence_type"},
      "source_url": {"type": "string"},
      "archived_url": {"type": ["string", "null"], "description": "Jina/Wayback 등. 원 URL과 구분 기록."},
      "local": {"type": ["string", "null"], "description": "_sources/ 로컬 스냅샷 경로"},
      "sha256": {"type": "string"},
      "accessed_at": {"type": "string"},
      "http_status": {"type": ["integer", "null"]},
      "locator": {"type": ["object", "null"], "description": "{page,row,col} | {selector} 등"},
      "verbatim": {"type": ["string", "null"], "description": "text_quote 일 때 필수(원문 그대로)"},
      "source_role": {"enum_ref": "source_role", "nullable": true},
      "capture": {"type": ["string", "null"], "description": "_captures/E###.png (source_capture)"},
      "observer_group": {"type": ["string", "null"], "description": "[v3] 독립성 판정용 관찰그룹 라벨"},
      "observed_at": {"type": ["string", "null"]},
      "verdict": {"type": ["string", "null"], "enum_ref": "evidence_verdict", "description": "[v4-V] 이 증거가 fact 주장을 support|contradict|uncertain 하는지 — 반박·상충 증거의 방향 기록(Bx negative_search 결박과 연동)"}
    },
    "conditional": {
      "text_quote_requires_verbatim": "type == 'text_quote' → verbatim 필수"
    }
  }
}
